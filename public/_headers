# Security headers, applied at the edge to every static response.
# CSP notes:
#   script-src 'self'  — all JS is in /assets/app.js; no inline <script>.
#   style-src  'self'  — all CSS is in /assets/site.css; no <style> blocks and
#                        no style="" attributes anywhere (including JS-built markup).
#   font-src   'self'  — fonts are self-hosted woff2 in /assets/fonts/.
#   connect-src 'self' — the only fetch() target is same-origin /api/release.
#   Zero third-party origins.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Long-cache the static assets (content is versioned by deploy).
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

# Fonts never change once shipped; cache them hard.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
